{
  "name": "roi-du-carton",
  "version": "3.68.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "planche": "esbuild scripts/planche-visages.tsx --bundle --format=esm --platform=node --jsx=automatic --packages=external --outfile=scripts/.planche.mjs --log-level=error && node scripts/.planche.mjs",
    "format": "prettier --write .",
    "cap:sync": "pnpm build && cap sync",
    "cap:add:ios": "cap add ios",
    "cap:icones": "python3 scripts/icones-android.py",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "planche-etat": "esbuild scripts/planche-etat.tsx --bundle --format=esm --platform=node --jsx=automatic --packages=external --outfile=scripts/.planche-etat.mjs --log-level=error && node scripts/.planche-etat.mjs",
    "test-etat": "esbuild scripts/test-etat-visage.tsx --bundle --format=esm --platform=node --jsx=automatic --packages=external --outfile=scripts/.test-etat.mjs --log-level=error && node scripts/.test-etat.mjs",
    "test-facturation": "node scripts/test-facturation.mjs",
    "test-points-entree": "node scripts/test-points-entree.mjs",
    "test-atelier-essai": "node scripts/test-atelier-essai.mjs",
    "test-etabli-atelier": "node scripts/test-etabli-atelier.mjs",
    "test-boutique-cadeau": "node scripts/test-boutique-cadeau.mjs",
    "captures-store": "node scripts/captures-store.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6",
    "@capacitor/android": "^6",
    "@capacitor/core": "^6",
    "@capacitor/filesystem": "^6",
    "@capacitor/haptics": "^6",
    "@capacitor/ios": "^6",
    "@capacitor/local-notifications": "^6",
    "@capacitor/share": "^6",
    "clsx": "^2.1.1",
    "cordova-plugin-purchase": "^13.18.0",
    "express": "^4.21.2",
    "framer-motion": "^12.23.22",
    "html-to-image": "^1.11.13",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@capacitor/cli": "^6",
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "add": "^2.0.6",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "pnpm": "^10.15.1",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "puppeteer-core": "23.11.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vite-plugin-manus-runtime": "^0.0.57",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    }
  }
}
